rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validCount(n) {
      return n is int && n >= 0 && n <= 1000000;
    }

    function validReceipt(docId, d) {
      return d.keys().hasOnly(['sentAt', 'hash', 'fields', 'rowCount', 'piiFound', 'piiReplaced', 'rawDescriptionsSent'])
        && d.keys().hasAll(['sentAt', 'hash', 'fields', 'rowCount'])
        && d.sentAt is string
        && d.sentAt.size() >= 20
        && d.sentAt.size() <= 30
        && d.sentAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$')
        && d.hash is string
        && d.hash.size() == 64
        && d.hash.matches('^[0-9a-f]{64}$')
        && d.fields is list
        && d.fields.size() >= 1
        && d.fields.size() <= 8
        && d.fields.hasOnly(['schema', 'mode', 'currency', 'period', 'totals', 'categories', 'vendors', 'signals'])
        && validCount(d.rowCount)
        && (!('piiFound' in d) || validCount(d.piiFound))
        && (!('piiReplaced' in d) || validCount(d.piiReplaced))
        && (!('rawDescriptionsSent' in d) || validCount(d.rawDescriptionsSent))
        && docId.matches('^[0-9]{10,15}-' + d.hash[0:16] + '$');
    }

    match /users/{uid}/receipts/{docId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validReceipt(docId, request.resource.data);
    }
  }
}
