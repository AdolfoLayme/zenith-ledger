# Firebase web config (Firebase console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check (production builds; dev uses the debug provider)
VITE_APPCHECK_SITE_KEY=
# Set to 1 to run the whole demo with scripted stand-ins instead of Gemini
VITE_DEMO_FAKE_AI=0
